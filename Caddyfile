# Caddy reverse proxy — sole entrypoint (ports 80/443).
# APP_DOMAIN is substituted from the environment at `docker compose up` time.
{$APP_DOMAIN}

reverse_proxy app:3000 {
  # Health + header hygiene; app serves SSR + /api/* from Next standalone.
  header_up Host {host}
  header_up X-Real-IP {remote}
  header_up X-Forwarded-Proto {scheme}
}

# Security headers + access logging (JSON to stdout, picked up by logrotate).
log {
  output stdout
  format json
}

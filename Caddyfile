# Caddy reverse proxy: sole entrypoint (ports 80/443).
hahastage.xyz, www.hahastage.xyz, haha.asifaq.com {
  reverse_proxy app:3000 {
    # Health and header hygiene: app serves SSR and /api/* from Next standalone.
    header_up Host {host}
    header_up X-Real-IP {remote}
    header_up X-Forwarded-Proto {scheme}
  }

  # Security headers and access logging (JSON to stdout, picked up by docker).
  log {
    output stdout
    format json
  }
}

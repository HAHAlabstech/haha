# =====================================================================
# HAHA .env.example — copy to .env / .env.app / .env.worker on the VPS.
# NEVER commit real secrets. Client config is served at runtime via
# /api/config — this file contains NO NEXT_PUBLIC_* secrets by design:
# every key below is SERVER-ONLY. Contract addresses are public on-chain
# data, not secrets, and live in lib/haha-contracts.ts defaults.
# =====================================================================

# --- 1. Network mode: "testnet" (Robinhood 46630) | "mainnet" (4663) ---
CHAIN_ENV=testnet
APP_URL=https://haha.example.com
APP_DOMAIN=haha.example.com
TAG=latest

# --- 2. Local Docker DB/Redis (service names inside compose network) ---
# For laptop dev against local docker, replace @db/@redis with @localhost.
DATABASE_URL=postgresql://haha:haha@localhost:5432/haha
DIRECT_URL=postgresql://haha:haha@localhost:5432/haha
DB_PASSWORD=change_me_in_production
REDIS_URL=redis://localhost:6379

# --- 3. VPS deploy (used by CI over SSH; values live in CI secrets) ---
VPS_HOST=43.134.60.117
VPS_USER=ubuntu
SSH_PRIVATE_KEY=<ci-secret-handle-not-a-value>

# --- 4. RPC upstreams (SERVER-ONLY — never NEXT_PUBLIC_*, never in bundle) ---
# Order: Alchemy -> publicnode -> public. Publicnode/public need no key.
ALCHEMY_API_KEY=
RPC_URL_TESTNET=https://robinhood-sepolia-rpc.publicnode.com
RPC_URL_MAINNET=https://robinhood-rpc.publicnode.com

# --- 5. Operator keys (SERVER-ONLY) ---
# Hot keeper key lives ONLY in the VPS worker env (ROOT_PROPOSER +
# slash-escrow capped; cannot finalize roots, cannot burn slash).
OPERATOR_PRIVATE_KEY=
# Cold offline guardian/admin address (veto + params). NEVER a private key.
ADMIN_COLD_ADDRESS=
COLD_TREASURY_ADDRESS=

# --- 6. Xiaomi MiMo 2.6 API (SERVER-ONLY) ---
# LOCKED 16 Okt 2026: pakai key tp- Token Plan via endpoint regional SGP
# (verified 200 + mimo-v2.6-pro/flash listed). Larangan tp- di-waive pemilik.
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MAIN_MODEL=mimo-v2.6-pro
MIMO_FAST_MODEL=mimo-v2.6-flash

# --- 7. Cloudflare R2 (S3-compatible, SERVER-ONLY) + Turnstile ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=haha-storage
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
# Vault AES-256-GCM data-key / KMS handle for wrapping per-snapshot DEKs.
VAULT_DEK_KMS_KEY=
TURNSTILE_SECRET_KEY=
# Turnstile site key is PUBLIC (rendered by the browser), served at runtime
# via /api/config — not a secret, but kept out of NEXT_PUBLIC_* anyway
# because NEXT_PUBLIC_* is frozen at build time (build image per env).
TURNSTILE_SITE_KEY=

# --- 8. Auth / sessions / ops (SERVER-ONLY) ---
SESSION_SECRET=generate_random_32_byte_hex_for_siwe_jwt
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BULLMQ_BOARD_PASSWORD=

# --- 9. Chain constants (public info, defaults in code; override here) ---
TESTNET_CHAIN_ID=46630
MAINNET_CHAIN_ID=4663
USDG_DECIMALS=6
CREATOR_TAX_BPS=200
GUARDIAN_DELAY_HOURS=24
GUARDIAN_DELAY_MINUTES_TESTNET=10
OPERATOR_MIN_ETH_ALERT=0.005
